# USSD gateway endpoint. Change this to point at any USSD backend.
USSD_ENDPOINT=http://localhost:3000/ussd/vodacom/process

# Default subscriber identity sent with every USSD request.
USSD_IMSI=123123123
USSD_MSISDN=255714585855

# Session inactivity timeout in seconds (client-side simulation of a real
# USSD session lifetime). After this the session is considered timed out.
NEXT_PUBLIC_USSD_SESSION_TIMEOUT=120
